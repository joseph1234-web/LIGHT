# Configure real values only in private Site runtime settings. Never commit secrets.
# Keep the existing encryption key when reconnecting accounts.
TOKEN_ENCRYPTION_KEY=
# Facebook Login for Pages (also supports a Page-linked professional Instagram account).
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=
# Optional direct Instagram professional account login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=
# YouTube Web OAuth client, YouTube Data API enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional live trend discovery.
YOUTUBE_API_KEY=
# Optional Canva REST API app. The owner can also save these in the private Canva setup form.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Trusted Site operator for the scoped church background tool.
CHURCH_AUTOMATION_OWNER_EMAIL=
# Account that requested the uploaded Christmas pack as its default.
CHRISTMAS_PACK_DEFAULT_EMAIL=

# Health metadata for the linked, independently running cloud schedule.
# Set ENABLED=true only after the actual linked task has been enabled.
CHURCH_SCHEDULER_ENABLED=
CHURCH_SCHEDULER_ACCOUNT_EMAIL=
# Optional expiring, one-time Site-admin preparation directive. Never a credential.
CHURCH_PREPARATION_REQUEST=
